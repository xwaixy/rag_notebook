# 必须与 backend/.env.docker 中的 SECRET_KEY 相同
JWT_SECRET_KEY=replace-with-the-same-long-random-secret-as-backend
ALLOWED_HOSTS=localhost,127.0.0.1,django

# Docker 内部 MySQL 服务
DB_ENGINE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=user_service
DB_USER=rag_app
DB_PASSWORD=replace-with-password-matching-docker-init

# FastAPI 业务数据库与运维页面
BACKEND_DB_NAME=chat_history
BACKEND_API_URL=http://backend:8000
BACKEND_STATUS_TIMEOUT=3
BACKEND_LOG_DIR=/backend-logs
BACKEND_LOG_MAX_LINES=500

# Docker 内部 Redis 服务
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=10
CELERY_TASK_SOFT_TIME_LIMIT=8
CELERY_RESULT_EXPIRES=3600
