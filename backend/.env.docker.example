# ==============================================
# Docker 后端环境变量示例（API 模型部署）
# ==============================================

# ==============================================
# LLM：OpenAI 兼容中转站
# ==============================================
LLM_TYPE=OPENAI
OPENAI_BASE_URL=https://your-relay.example.com/v1
OPENAI_API_KEY=replace-with-your-relay-api-key
OPENAI_MODEL_NAME=replace-with-chat-model-name
OPENAI_TRUST_ENV=true
OPENAI_USE_RESPONSES_API=false
OPENAI_DISABLE_RESPONSE_STORAGE=false

# 中转站需要代理时配置；如果不需要代理，可删除或留空这三项。
# 代理在服务器宿主机上时，后端容器通过 host.docker.internal 访问。
HTTP_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,mysql,redis,django,backend,front,host.docker.internal

# ==============================================
# Embedding：在线 API
# ==============================================
# 当前代码的在线 Embedding 通道使用 ALIYUN 配置名。
# 如果你的中转站也提供 OpenAI 兼容 Embedding，可把 ALIYUN_BASE_URL 和
# ALIYUN_ACCESS_KEY_SECRET 改成该中转站的兼容地址和 Key。
EMBED_MODEL_TYPE=ALIYUN
ALIYUN_ACCESS_KEY_SECRET=replace-with-embedding-api-key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_EMBED_MODEL_NAME=qwen3-embedding

# ==============================================
# PDF 视觉理解：在线 API，可按需启用
# ==============================================
# 不处理 PDF 图片内容时建议关闭，避免额外 API 费用。
VISION_MODEL_TYPE=DISABLED
VISION_CHAT_MODEL_NAME=qwen-vl-max

# ==============================================
# Reranker：阿里云百炼 Qwen3-VL-Rerank API
# API Key 默认复用 ALIYUN_ACCESS_KEY_SECRET；也可单独设置 RERANKER_API_KEY。
# 百炼新版端点需要工作空间 ID，也可以用 RERANKER_BASE_URL 配置完整接口地址。
# ==============================================
RERANKER_ENABLED=false
RERANKER_PROVIDER=ALIYUN
RERANKER_MODEL_NAME=qwen3-vl-rerank
RERANKER_WORKSPACE_ID=replace-with-your-workspace-id
RERANKER_REGION=cn-beijing
# RERANKER_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_TOP_N=8
RERANKER_TIMEOUT=30
RERANKER_MAX_DOCUMENTS=100

# ==============================================
# Docker 内部服务地址
# ==============================================
MYSQL_USER=rag_app
MYSQL_PASSWORD=replace-with-password-matching-docker-init
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=chat_history

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
DJANGO_API_URL=http://django:8001

# Backend 与 Django 必须配置为同一个长随机密钥。
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256

RATE_LIMIT_ENABLED=true
LANGCHAIN_TRACING_V2=false
