# 聊天模型：ALIYUN、OLLAMA 或 OPENAI
LLM_TYPE=ALIYUN
ALIYUN_ACCESS_KEY_SECRET=replace-with-api-key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL_NAME=qwen3-max

# 本地向量模型目录来自 Compose 挂载的 /models
EMBED_MODEL_TYPE=LOCAL_QWEN
LOCAL_EMBED_MODEL_PATH=/models/Qwen3-Embedding-0.6B
LOCAL_EMBED_DEVICE=cpu

# 重排序默认关闭；启用前确认模型已放入宿主机模型目录
RERANKER_ENABLED=false
RERANKER_MODEL_PATH=/models/Qwen3-Reranker-0.6B
RERANKER_DEVICE=cpu

# PDF 视觉理解；不需要时可设为 DISABLED
VISION_MODEL_TYPE=ALIYUN
VISION_CHAT_MODEL_NAME=qwen-vl-max

# Docker 内部服务地址
MYSQL_USER=rag_app
MYSQL_PASSWORD=replace-with-password-matching-docker-init
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=chat_history

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
DJANGO_API_URL=http://django:8001

# Backend 与 Django 必须配置为同一个长随机密钥
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256

RATE_LIMIT_ENABLED=true
LANGCHAIN_TRACING_V2=false
