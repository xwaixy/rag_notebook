# ==============================================
# 本地开发后端环境变量示例（API 模型）
# ==============================================

# LLM：OpenAI 兼容中转站
LLM_TYPE=OPENAI
OPENAI_BASE_URL=https://your-relay.example.com/v1
OPENAI_API_KEY=replace-with-your-relay-api-key
OPENAI_MODEL_NAME=replace-with-chat-model-name
OPENAI_TRUST_ENV=true
OPENAI_USE_RESPONSES_API=false
OPENAI_DISABLE_RESPONSE_STORAGE=false

# 中转站需要代理时配置；本地开发通常使用 127.0.0.1。
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1

# Embedding：在线 API
# 当前代码的在线 Embedding 通道使用 ALIYUN 配置名。
EMBED_MODEL_TYPE=ALIYUN
ALIYUN_ACCESS_KEY_SECRET=replace-with-embedding-api-key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_EMBED_MODEL_NAME=qwen3-embedding

# PDF 视觉理解：不需要时关闭，避免额外 API 费用。
VISION_MODEL_TYPE=DISABLED
VISION_CHAT_MODEL_NAME=qwen-vl-max
VISION_BATCH_SIZE=5
VISION_DEDUP_ENABLED=true
VISION_DEDUP_THRESHOLD=10
VISION_BATCH_LOW_RES=true

# 阿里云百炼 Qwen3-VL-Rerank。API Key 默认复用 ALIYUN_ACCESS_KEY_SECRET，
# 也可通过 RERANKER_API_KEY 单独配置。启用前请填写工作空间 ID。
RERANKER_ENABLED=false
RERANKER_PROVIDER=ALIYUN
RERANKER_MODEL_NAME=qwen3-vl-rerank
RERANKER_WORKSPACE_ID=replace-with-your-workspace-id
RERANKER_REGION=cn-beijing
# RERANKER_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_TOP_N=8
RERANKER_TIMEOUT=30
RERANKER_MAX_DOCUMENTS=100

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-local-mysql-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=chat_history

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Django 用户服务地址
DJANGO_API_URL=http://127.0.0.1:8001

# 限流配置
RATE_LIMIT_ENABLED=false

# LangSmith 调试追踪；不需要时保持 false。
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=replace-with-langsmith-api-key
LANGCHAIN_PROJECT=rag-notebook

# JWT 身份验证配置，需与 DjangoUserService 的 JWT_SECRET_KEY 一致。
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
